# Copy this file to .env.dev.local and adjust values for your local Docker environment
# .env.dev.local is NOT committed to git (see .gitignore)

###> symfony/framework-bundle ###
APP_ENV=dev
# APP_SECRET is auto-generated in Docker - no need to set manually
# Outside Docker, generate with: php -r "echo bin2hex(random_bytes(16));"
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# URL for CLI commands (adjust port if you change NGINX_PORT below)
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Docker MariaDB 10.4 configuration
# The hostname 'database' refers to the Docker service name in compose.yaml
DATABASE_URL="mysql://symfony:symfony@database:3306/symfony_app?serverVersion=mariadb-10.4&charset=utf8mb4"

# Docker database credentials (used by docker-compose.yaml)
# Change these if you want different credentials in your local environment
DB_ROOT_PASSWORD=root
DB_DATABASE=symfony_app
DB_USER=symfony
DB_PASSWORD=symfony
MAPPED_DB_PORT=3306
DB_VERSION=mariadb-10.4.14
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# Mailpit is disabled by default
# To enable, uncomment the mailer service in compose.override.yaml
# MAILER_DSN=smtp://mailer:1025
###< symfony/mailer ###

###> Docker configuration ###
# Nginx port on host machine (default: 8080)
# Access your app at http://localhost:NGINX_PORT
NGINX_PORT=8080

# Xdebug mode: off, debug, coverage, develop, profile, trace
# Set to "debug" to enable step debugging, "off" to disable
XDEBUG_MODE=off
###< Docker configuration ###
