{% extends 'base.html.twig' %}

{% block title %}Main Page{% endblock %}

{% block body %}
    <div class="py-6">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <!-- Page header -->
            <div class="md:flex md:items-center md:justify-between mb-6">
                <div class="min-w-0 flex-1">
                    <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:tracking-tight">
                        Hello, welcome to my decent app
                    </h2>
                    <p class="mt-4 text-gray-600">
                        A Symfony-based solution demonstrating clean API integration, DTO-driven design, and efficient data synchronization
                    </p>
                    <p class="mt-4">
                        <a href="{{ path('app_github_repository') }}" class="text-indigo-600 hover:text-indigo-500 font-medium">
                            View my code challenge →
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
