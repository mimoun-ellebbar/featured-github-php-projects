{% extends 'base.html.twig' %}

{% block title %}Code Challenge - GitHub Repositories{% endblock %}

{% block body %}
<div class="py-6">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- Page header -->
        <div class="md:flex md:items-center md:justify-between mb-6">
            <div class="min-w-0 flex-1">
                <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight">
                    PHP GitHub Repositories
                </h2>
            </div>
            <div class="mt-4 flex md:ml-4 md:mt-0">
                <form method="post" action="{{ path('app_github_repository_refresh') }}" onsubmit="return confirmRefresh()">
                    <button type="submit" id="refreshButton" class="inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 transition-all disabled:opacity-50 disabled:cursor-not-allowed">
                        <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                        </svg>
                        <span id="refreshButtonText">Refresh Database</span>
                    </button>
                </form>
            </div>
        </div>

        <!-- Main layout with sidebar -->
        <div class="flex flex-col lg:flex-row gap-6 lg:gap-8">
            <!-- Left Sidebar - Filters -->
            <aside class="lg:w-64 flex-shrink-0">
                <div class="bg-white shadow-sm ring-1 ring-gray-900/5 rounded-lg sticky top-6">
                    <div class="px-4 py-5">
                        <h3 class="text-sm font-semibold text-gray-900 mb-4">Filters</h3>
                        <form method="get" action="{{ path('app_github_repository') }}">
                            <div class="space-y-4">
                                <!-- Search by name -->
                                <div>
                                    <label for="search" class="block text-sm font-medium text-gray-700 mb-1">Search by name</label>
                                    <input type="text" name="search" id="search" value="{{ app.request.get('search') }}"
                                           class="block w-full rounded-md border-0 py-1.5 px-3 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
                                           placeholder="Repository name...">
                                </div>

                                <!-- Min stars -->
                                <div>
                                    <label for="min_stars" class="block text-sm font-medium text-gray-700 mb-1">Min stars</label>
                                    <input type="number" name="min_stars" id="min_stars" value="{{ app.request.get('min_stars') }}"
                                           class="block w-full rounded-md border-0 py-1.5 px-3 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
                                           placeholder="0">
                                </div>

                                <!-- Per page -->
                                <div>
                                    <label for="per_page" class="block text-sm font-medium text-gray-700 mb-1">Items per page</label>
                                    <select name="per_page" id="per_page" class="block w-full rounded-md border-0 py-1.5 px-3 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                                        <option value="10" {% if app.request.get('per_page', 10) == 10 %}selected{% endif %}>10</option>
                                        <option value="30" {% if app.request.get('per_page', 10) == 30 %}selected{% endif %}>30</option>
                                        <option value="60" {% if app.request.get('per_page', 10) == 60 %}selected{% endif %}>60</option>
                                        <option value="100" {% if app.request.get('per_page', 10) == 100 %}selected{% endif %}>100</option>
                                    </select>
                                </div>

                                <!-- Filter button -->
                                <div class="pt-2">
                                    <button type="submit" class="w-full rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                                        Apply Filters
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </aside>

            <!-- Right Content Area -->
            <div class="flex-1 min-w-0">

        <!-- Pagination -->
        {% if repositories is defined and repositories|length > 0 %}
            {% set per_page = app.request.get('per_page', 10) %}
            {% set total_pages = (totalAll / per_page)|round(0, 'ceil') %}

            <div class="bg-white px-4 py-3 sm:px-6 mb-6 rounded-lg shadow-sm border-t border-gray-200">
                <!-- Mobile Pagination -->
                <div class="flex flex-1 justify-between sm:hidden">
                    {% if page > 1 %}
                        <a href="?page={{ page - 1 }}{% if app.request.get('search') %}&search={{ app.request.get('search') }}{% endif %}{% if app.request.get('min_stars') %}&min_stars={{ app.request.get('min_stars') }}{% endif %}{% if app.request.get('per_page') %}&per_page={{ app.request.get('per_page') }}{% endif %}"
                           class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
                            Previous
                        </a>
                    {% else %}
                        <span class="relative inline-flex items-center rounded-md border border-gray-300 bg-gray-50 px-4 py-2 text-sm font-medium text-gray-400 cursor-not-allowed">
                            Previous
                        </span>
                    {% endif %}

                    {% if page < total_pages %}
                        <a href="?page={{ page + 1 }}{% if app.request.get('search') %}&search={{ app.request.get('search') }}{% endif %}{% if app.request.get('min_stars') %}&min_stars={{ app.request.get('min_stars') }}{% endif %}{% if app.request.get('per_page') %}&per_page={{ app.request.get('per_page') }}{% endif %}"
                           class="relative ml-3 inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
                            Next
                        </a>
                    {% else %}
                        <span class="relative ml-3 inline-flex items-center rounded-md border border-gray-300 bg-gray-50 px-4 py-2 text-sm font-medium text-gray-400 cursor-not-allowed">
                            Next
                        </span>
                    {% endif %}
                </div>

                <!-- Desktop Pagination -->
                <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                    <div>
                        <p class="text-sm text-gray-700">
                            Showing
                            <span class="font-medium">{{ ((page - 1) * per_page) + 1 }}</span>
                            to
                            <span class="font-medium">{{ min(page * per_page, totalAll) }}</span>
                            of
                            <span class="font-medium">{{ totalAll }}</span>
                            results
                        </p>
                    </div>
                    <div>
                        <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                            {# Previous Button #}
                            {% if page > 1 %}
                                <a href="?page={{ page - 1 }}{% if app.request.get('search') %}&search={{ app.request.get('search') }}{% endif %}{% if app.request.get('min_stars') %}&min_stars={{ app.request.get('min_stars') }}{% endif %}{% if app.request.get('per_page') %}&per_page={{ app.request.get('per_page') }}{% endif %}"
                                   class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                    <span class="sr-only">Previous</span>
                                    <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                        <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" />
                                    </svg>
                                </a>
                            {% else %}
                                <span class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-300 ring-1 ring-inset ring-gray-300 bg-gray-50 cursor-not-allowed">
                                    <span class="sr-only">Previous</span>
                                    <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                        <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" />
                                    </svg>
                                </span>
                            {% endif %}

                            {# Page Numbers #}
                            {% set start_page = max(1, page - 2) %}
                            {% set end_page = min(total_pages, page + 2) %}

                            {# First page if not in range #}
                            {% if start_page > 1 %}
                                <a href="?page=1{% if app.request.get('search') %}&search={{ app.request.get('search') }}{% endif %}{% if app.request.get('min_stars') %}&min_stars={{ app.request.get('min_stars') }}{% endif %}{% if app.request.get('per_page') %}&per_page={{ app.request.get('per_page') }}{% endif %}"
                                   class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                    1
                                </a>
                                {% if start_page > 2 %}
                                    <span class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300">...</span>
                                {% endif %}
                            {% endif %}

                            {# Page number range #}
                            {% for i in start_page..end_page %}
                                {% if i == page %}
                                    <span class="relative z-10 inline-flex items-center bg-indigo-600 px-4 py-2 text-sm font-semibold text-white focus:z-20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                                        {{ i }}
                                    </span>
                                {% else %}
                                    <a href="?page={{ i }}{% if app.request.get('search') %}&search={{ app.request.get('search') }}{% endif %}{% if app.request.get('min_stars') %}&min_stars={{ app.request.get('min_stars') }}{% endif %}{% if app.request.get('per_page') %}&per_page={{ app.request.get('per_page') }}{% endif %}"
                                       class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                        {{ i }}
                                    </a>
                                {% endif %}
                            {% endfor %}

                            {# Last page if not in range #}
                            {% if end_page < total_pages %}
                                {% if end_page < total_pages - 1 %}
                                    <span class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-700 ring-1 ring-inset ring-gray-300">...</span>
                                {% endif %}
                                <a href="?page={{ total_pages }}{% if app.request.get('search') %}&search={{ app.request.get('search') }}{% endif %}{% if app.request.get('min_stars') %}&min_stars={{ app.request.get('min_stars') }}{% endif %}{% if app.request.get('per_page') %}&per_page={{ app.request.get('per_page') }}{% endif %}"
                                   class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                    {{ total_pages }}
                                </a>
                            {% endif %}

                            {# Next Button #}
                            {% if page < total_pages %}
                                <a href="?page={{ page + 1 }}{% if app.request.get('search') %}&search={{ app.request.get('search') }}{% endif %}{% if app.request.get('min_stars') %}&min_stars={{ app.request.get('min_stars') }}{% endif %}{% if app.request.get('per_page') %}&per_page={{ app.request.get('per_page') }}{% endif %}"
                                   class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20 focus:outline-offset-0">
                                    <span class="sr-only">Next</span>
                                    <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                                    </svg>
                                </a>
                            {% else %}
                                <span class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-300 ring-1 ring-inset ring-gray-300 bg-gray-50 cursor-not-allowed">
                                    <span class="sr-only">Next</span>
                                    <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                                    </svg>
                                </span>
                            {% endif %}
                        </nav>
                    </div>
                </div>
            </div>
        {% endif %}

        <!-- Table Section -->
        <div class="bg-white shadow-sm ring-1 ring-gray-900/5 sm:rounded-lg overflow-hidden">
            <!-- Mobile view (cards) -->
            <div class="block lg:hidden max-h-[600px] overflow-y-auto">
                {% if repositories is defined and repositories|length > 0 %}
                    <div class="divide-y divide-gray-200">
                        {% for repo in repositories %}
                        <div class="p-4 hover:bg-gray-50 cursor-pointer transition-colors" onclick="openModal({{ repo.repo_id }})">
                            <div class="flex items-center justify-between mb-2">
                                <h3 class="text-sm font-semibold text-gray-900">{{ repo.name }}</h3>
                                <span class="inline-flex items-center rounded-full bg-yellow-50 px-2 py-1 text-xs font-medium text-yellow-800">
                                    ⭐ {{ repo.stars_count|number_format }}
                                </span>
                            </div>
                            <div class="mt-3">
                                <button onclick="event.stopPropagation(); openModal({{ repo.repo_id }})" class="text-sm font-medium text-indigo-600 hover:text-indigo-500 focus:outline-none">
                                    View Details →
                                </button>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="p-8 text-center text-gray-500">
                        <p>No repositories found. Try adjusting your filters.</p>
                    </div>
                {% endif %}
            </div>

            <!-- Desktop view (table) -->
            <div class="hidden lg:block max-h-[600px] overflow-y-auto">
                <table class="min-w-full divide-y divide-gray-300">
                    <thead class="bg-gray-50 sticky top-0 z-10">
                        <tr>
                            <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6 bg-gray-50">Name</th>
                            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 bg-gray-50">Stars</th>
                            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900 bg-gray-50">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 bg-white">
                        {% if repositories is defined and repositories|length > 0 %}
                            {% for repo in repositories %}
                            <tr class="hover:bg-gray-50 cursor-pointer transition-colors" onclick="openModal({{ repo.repo_id }})">
                                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">
                                    {{ repo.name }}
                                </td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                                    <span class="inline-flex items-center rounded-full bg-yellow-50 px-2 py-1 text-xs font-medium text-yellow-800">
                                        ⭐ {{ repo.stars_count|number_format }}
                                    </span>
                                </td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm font-medium">
                                    <button onclick="event.stopPropagation(); openModal({{ repo.repo_id }})" class="text-indigo-600 hover:text-indigo-900 focus:outline-none">
                                        View Details
                                    </button>
                                </td>
                            </tr>
                            {% endfor %}
                        {% else %}
                            <tr>
                                <td colspan="6" class="px-3 py-8 text-center text-sm text-gray-500">
                                    No repositories found. Try adjusting your filters.
                                </td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
            </div>
        </div>
    </div>
</div>

<!-- Repository Details Modal -->
<div id="repoModal" class="hidden fixed inset-0 bg-gray-500 bg-opacity-75 z-50 transition-opacity">
    <div class="flex min-h-full items-center justify-center p-4">
        <div class="bg-white rounded-lg shadow-xl max-w-2xl w-full p-6 transform transition-all">
            <!-- Modal Header -->
            <div class="flex justify-between items-start mb-4">
                <h3 id="modalTitle" class="text-xl font-bold text-gray-900"></h3>
                <button onclick="closeModal()" class="text-gray-400 hover:text-gray-500 focus:outline-none">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Modal Content -->
            <div class="space-y-4">
                <!-- Description -->
                <div>
                    <label class="block text-sm font-medium text-gray-500 mb-1">Description</label>
                    <p id="modalDescription" class="text-gray-900 text-sm leading-relaxed"></p>
                </div>

                <!-- Created Date and Last Push -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-500 mb-1">Created Date</label>
                        <p id="modalCreated" class="text-gray-900"></p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-500 mb-1">Last Push</label>
                        <p id="modalLastPush" class="text-gray-900"></p>
                    </div>
                </div>

                <!-- Last Updated -->
                <div>
                    <label class="block text-sm font-medium text-gray-500 mb-1">Last Updated</label>
                    <p id="modalUpdated" class="text-gray-900"></p>
                </div>

                <!-- Repository URL -->
                <div>
                    <label class="block text-sm font-medium text-gray-500 mb-1">Repository URL</label>
                    <p id="modalUrl" class="text-sm text-gray-600 break-all"></p>
                </div>

                <!-- Modal Actions -->
                <div class="pt-4 flex flex-col sm:flex-row justify-end gap-3">
                    <button onclick="closeModal()" class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-md hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        Close
                    </button>
                    <a id="modalGithubLink" href="#" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                        <svg class="mr-2 h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                        </svg>
                        View on GitHub
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="module">
    import RepoModelView from 'repository/modal_view';

const App = {
    modal: null,
    init(){
        this.modal = new RepoModelView();
    },
    confirmRefresh() {
        const button = document.querySelector('#refreshButton');
        const buttonText = document.querySelector('#refreshButtonText');

        if (confirm('This will fetch the latest PHP repositories from GitHub and update the database. This may take a few moments. Continue?')) {
            // Disable button and show loading state
            if (button) {
                button.disabled = true;
            }
            if (buttonText) {
                buttonText.textContent = 'Refreshing...';
            }

            // Add spinning animation to icon
            const icon = button?.querySelector('svg');
            if (icon) {
                icon.classList.add('animate-spin');
            }

            console.log('Refresh confirmed');
            return true;
        }
        return false;
    }
};

window.openModal = function (repoId) {
    App.modal.openModal(repoId);
}

window.closeModal = function () {
    App.modal.closeModal();
}

window.confirmRefresh = function () {
    return App.confirmRefresh();
}

// Initialize when DOM is ready
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => App.init());
} else {
    App.init();
}
</script>
{% endblock %}
