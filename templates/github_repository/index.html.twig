{% extends 'base.html.twig' %}

{% block title %}Code Challenge - GitHub Repositories{% endblock %}

{% block body %}
<div class="py-6">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- Page header -->
        <div class="md:flex md:items-center md:justify-between mb-6">
            <div class="min-w-0 flex-1">
                <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:truncate sm:text-3xl sm:tracking-tight">
                    PHP GitHub Repositories
                </h2>
            </div>
        </div>

        <!-- Filters Section -->
        <div class="bg-white shadow-sm ring-1 ring-gray-900/5 sm:rounded-lg mb-6">
            <div class="px-4 py-5 sm:p-6">
                <form method="get" action="{{ path('app_github_repository') }}">
                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
                        <!-- Search by name -->
                        <div>
                            <label for="search" class="block text-sm font-medium text-gray-700 mb-1">Search by name</label>
                            <input type="text" name="search" id="search" value="{{ app.request.get('search') }}"
                                   class="block w-full rounded-md border-0 py-1.5 px-3 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
                                   placeholder="Repository name...">
                        </div>

                        <!-- Min stars -->
                        <div>
                            <label for="min_stars" class="block text-sm font-medium text-gray-700 mb-1">Min stars</label>
                            <input type="number" name="min_stars" id="min_stars" value="{{ app.request.get('min_stars') }}"
                                   class="block w-full rounded-md border-0 py-1.5 px-3 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
                                   placeholder="0">
                        </div>

                        <!-- Sort by -->
                        <div>
                            <label for="sort" class="block text-sm font-medium text-gray-700 mb-1">Sort by</label>
                            <select name="sort" id="sort" class="block w-full rounded-md border-0 py-1.5 px-3 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                                <option value="stars" {% if app.request.get('sort') == 'stars' %}selected{% endif %}>Stars (High to Low)</option>
                                <option value="name" {% if app.request.get('sort') == 'name' %}selected{% endif %}>Name (A-Z)</option>
                                <option value="created" {% if app.request.get('sort') == 'created' %}selected{% endif %}>Created Date</option>
                                <option value="updated" {% if app.request.get('sort') == 'updated' %}selected{% endif %}>Last Updated</option>
                            </select>
                        </div>

                        <!-- Filter button -->
                        <div class="flex items-end">
                            <button type="submit" class="w-full rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                                Apply Filters
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Table Section -->
        <div class="bg-white shadow-sm ring-1 ring-gray-900/5 sm:rounded-lg overflow-hidden">
            <!-- Mobile view (cards) -->
            <div class="block lg:hidden">
                {% if repositories is defined and repositories|length > 0 %}
                    <div class="divide-y divide-gray-200">
                        {% for repo in repositories %}
                        <div class="p-4 hover:bg-gray-50">
                            <div class="flex items-center justify-between mb-2">
                                <h3 class="text-sm font-semibold text-gray-900">{{ repo.name }}</h3>
                                <span class="inline-flex items-center rounded-full bg-yellow-50 px-2 py-1 text-xs font-medium text-yellow-800">
                                    ⭐ {{ repo.starsCount|number_format }}
                                </span>
                            </div>
                            {% if repo.description %}
                            <p class="text-sm text-gray-600 mb-2">{{ repo.description|slice(0, 100) }}{% if repo.description|length > 100 %}...{% endif %}</p>
                            {% endif %}
                            <div class="text-xs text-gray-500 space-y-1">
                                <div>Created: {{ repo.createdAt|date('Y-m-d') }}</div>
                                <div>Last Push: {{ repo.lastPushedAt|date('Y-m-d') }}</div>
                            </div>
                            <div class="mt-3">
                                <a href="{{ repo.url }}" target="_blank" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">
                                    View on GitHub →
                                </a>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="p-8 text-center text-gray-500">
                        <p>No repositories found. Try adjusting your filters.</p>
                    </div>
                {% endif %}
            </div>

            <!-- Desktop view (table) -->
            <div class="hidden lg:block overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-300">
                    <thead class="bg-gray-50">
                        <tr>
                            <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Name</th>
                            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Stars</th>
                            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200 bg-white">
                        {% if repositories is defined and repositories|length > 0 %}
                            {% for repo in repositories %}
                            <tr class="hover:bg-gray-50">
                                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">
                                    {{ repo.name }}
                                </td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                                    <span class="inline-flex items-center rounded-full bg-yellow-50 px-2 py-1 text-xs font-medium text-yellow-800">
                                        ⭐ {{ repo.starsCount|number_format }}
                                    </span>
                                </td>
                                <td class="whitespace-nowrap px-3 py-4 text-sm font-medium">
                                    <a href="{{ repo.url }}" target="_blank" class="text-indigo-600 hover:text-indigo-900">
                                        View
                                    </a>
                                </td>
                            </tr>
                            {% endfor %}
                        {% else %}
                            <tr>
                                <td colspan="6" class="px-3 py-8 text-center text-sm text-gray-500">
                                    No repositories found. Try adjusting your filters.
                                </td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        {% if repositories is defined and repositories|length > 0 %}
        <div class="flex items-center justify-between border-t border-gray-200 bg-white px-4 py-3 sm:px-6 mt-6 rounded-lg shadow-sm">
            <div class="flex flex-1 justify-between sm:hidden">
                {% if page > 1 %}
                <a href="?page={{ page - 1 }}{% if app.request.get('search') %}&search={{ app.request.get('search') }}{% endif %}{% if app.request.get('min_stars') %}&min_stars={{ app.request.get('min_stars') }}{% endif %}{% if app.request.get('sort') %}&sort={{ app.request.get('sort') }}{% endif %}"
                   class="relative inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
                    Previous
                </a>
                {% endif %}
                {% if repositories|length == 10 %}
                <a href="?page={{ page + 1 }}{% if app.request.get('search') %}&search={{ app.request.get('search') }}{% endif %}{% if app.request.get('min_stars') %}&min_stars={{ app.request.get('min_stars') }}{% endif %}{% if app.request.get('sort') %}&sort={{ app.request.get('sort') }}{% endif %}"
                   class="relative ml-3 inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">
                    Next
                </a>
                {% endif %}
            </div>
            <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
                <div>
                    <p class="text-sm text-gray-700">
                        Showing page <span class="font-medium">{{ page|default(1) }}</span>
                    </p>
                </div>
                <div>
                    <nav class="isolate inline-flex -space-x-px rounded-md shadow-sm" aria-label="Pagination">
                        {% if page > 1 %}
                        <a href="?page={{ page - 1 }}{% if app.request.get('search') %}&search={{ app.request.get('search') }}{% endif %}{% if app.request.get('min_stars') %}&min_stars={{ app.request.get('min_stars') }}{% endif %}{% if app.request.get('sort') %}&sort={{ app.request.get('sort') }}{% endif %}"
                           class="relative inline-flex items-center rounded-l-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20">
                            <span class="sr-only">Previous</span>
                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z" clip-rule="evenodd" />
                            </svg>
                        </a>
                        {% endif %}

                        <span class="relative inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300">
                            {{ page|default(1) }}
                        </span>

                        {% if repositories|length == 10 %}
                        <a href="?page={{ page + 1 }}{% if app.request.get('search') %}&search={{ app.request.get('search') }}{% endif %}{% if app.request.get('min_stars') %}&min_stars={{ app.request.get('min_stars') }}{% endif %}{% if app.request.get('sort') %}&sort={{ app.request.get('sort') }}{% endif %}"
                           class="relative inline-flex items-center rounded-r-md px-2 py-2 text-gray-400 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:z-20">
                            <span class="sr-only">Next</span>
                            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                            </svg>
                        </a>
                        {% endif %}
                    </nav>
                </div>
            </div>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
