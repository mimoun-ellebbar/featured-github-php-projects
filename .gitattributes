# Auto detect text files and perform LF normalization
* text=auto

# Force LF line endings for shell scripts (important for Docker/Linux)
*.sh text eol=lf
*.bash text eol=lf

# Force LF for other script files
*.py text eol=lf
*.php text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf

# Force LF for Docker files
Dockerfile* text eol=lf
docker-compose*.yml text eol=lf
compose*.yaml text eol=lf

# Force LF for config files
*.conf text eol=lf
*.ini text eol=lf
.env* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
